# ── Required ────────────────────────────────────────────────
# Supabase: use the pooled connection string (Settings → Database → Connection string → Transaction pooler)
DATABASE_URL=postgres://radar:radar@localhost:5432/ai_radar
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (used in emails, auth callbacks and canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret that Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me

# ── Optional ────────────────────────────────────────────────
# Enables LLM classification, deduplication and summaries. Without it a keyword heuristic is used.
ANTHROPIC_API_KEY=
# Model used by the ingestion pipeline (defaults to claude-opus-5-5)
AI_RADAR_MODEL=
# Enables real email delivery (digests, invitations). Without it emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="AI Radar <radar@northlabs.io>"
# Comma-separated emails that are promoted to North Labs platform admin on sign-up
PLATFORM_ADMIN_EMAILS=
# Who receives "Talk to North Labs" form submissions
CONTACT_NOTIFY_EMAIL=
# "true" blocks Gmail/Outlook/etc. sign-ups entirely. Default: personal emails allowed after a nudge.
REQUIRE_WORK_EMAIL=false
# Company enrichment (e.g. Clay). New business domains are POSTed to the webhook URL…
ENRICHMENT_WEBHOOK_URL=
ENRICHMENT_WEBHOOK_TOKEN=
# …and results come back to /api/integrations/enrichment with "Authorization: Bearer <secret>"
ENRICHMENT_API_SECRET=
# Single sign-on. Buttons show "Soon" until both values are set.
# Google: OAuth client (Web) in Google Cloud Console; redirect URI {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: Entra ID app registration; redirect URI {APP_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "organizations" (default) = work/school accounts only. Use "common" to also allow personal Microsoft accounts.
MICROSOFT_TENANT_ID=organizations
