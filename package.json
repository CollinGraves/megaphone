{
  "name": "ai-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/seed-sources.ts",
    "db:seed-demo": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/seed-demo.ts",
    "ingest": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/ingest.ts",
    "digest": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/send-digests.ts",
    "db:backfill-companies": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/backfill-companies.ts",
    "db:backfill-graph": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/backfill-graph.ts",
    "db:seed-graph-demo": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/seed-graph-demo.ts",
    "db:bootstrap-sql": "tsx --tsconfig tsconfig.json scripts/export-bootstrap-sql.ts",
    "stripe:setup": "tsx --tsconfig tsconfig.json scripts/stripe-setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-auth": "^1.7.23",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.72.0",
    "mcp-handler": "^2.4.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
